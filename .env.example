SRE_RAG_ENVIRONMENT=development
SRE_RAG_LOG_LEVEL=INFO
SRE_RAG_API_BASE_URL=http://localhost:8000

# Local vector store
SRE_RAG_QDRANT_URL=http://localhost:6333
SRE_RAG_QDRANT_COLLECTION_NAME=sre_kubernetes_chunks
SRE_RAG_INDEX_CHUNKS_PATH=data/processed/chunks.jsonl
SRE_RAG_INDEX_METADATA_PATH=data/processed/index-manifest.json
SRE_RAG_MODEL_DEVICE=auto

# Hosted generation and evaluation
SRE_RAG_OPENAI_API_KEY=
SRE_RAG_OPENAI_GENERATION_MODEL=gpt-5.6-luna
SRE_RAG_OPENAI_EVALUATION_MODEL=gpt-5.6-terra
SRE_RAG_OPENAI_REASONING_EFFORT=none
SRE_RAG_GENERATION_MAX_OUTPUT_TOKENS=800
SRE_RAG_GENERATION_TIMEOUT_SECONDS=30

# Local fallback generation
SRE_RAG_OLLAMA_BASE_URL=http://localhost:11434
SRE_RAG_OLLAMA_MODEL=qwen3:8b
PYTORCH_ENABLE_MPS_FALLBACK=1

# Langfuse Cloud
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development
SRE_RAG_LANGFUSE_ENABLED=true

# Local operations dashboard (set a non-empty password before starting Compose)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
